FROM rust:1.98.1-bookworm

ENV DEBIAN_FRONTEND=noninteractive \
    RUSTUP_DIST_SERVER=https://rsproxy.cn \
    RUSTUP_UPDATE_ROOT=https://rsproxy.cn/rustup

RUN apt-get update \
    && apt-get install --yes --no-install-recommends \
        build-essential \
        ca-certificates \
        clang \
        cmake \
        curl \
        git \
        libprotobuf-dev \
        libssl-dev \
        lld \
        nasm \
        pkg-config \
        protobuf-compiler \
    && rm -rf /var/lib/apt/lists/*

COPY entrypoint.sh /usr/local/bin/lance-dev-entrypoint
RUN chmod +x /usr/local/bin/lance-dev-entrypoint

WORKDIR /workspace/lance

ENTRYPOINT ["lance-dev-entrypoint"]
CMD ["sleep", "infinity"]
